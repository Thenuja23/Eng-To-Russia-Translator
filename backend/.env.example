# ---------------------------------------------------------------------------
# Optional Google Cloud Translation (Basic v2)
#
# Set an API key from Google Cloud Console (APIs & Services -> Credentials) to
# enable the "google", "auto" and "hybrid" translation engines. The key is used
# server-side only. Without it the app stays fully offline and the UI hides the
# Google options.
# ---------------------------------------------------------------------------
GOOGLE_TRANSLATE_API_KEY=
# Alias supported for existing deployments:
# GOOGLE_API_KEY=
GOOGLE_TRANSLATE_BASE_URL=https://translation.googleapis.com/language/translate/v2
GOOGLE_TRANSLATE_TIMEOUT_SECONDS=20
GOOGLE_TRANSLATE_RETRIES=2
GOOGLE_TRANSLATE_MAX_CHARS=4000

# Cache successful translations (seconds / entries). Helps avoid paying twice
# for the same debounced keystroke.
TRANSLATION_CACHE_TTL_SECONDS=900
TRANSLATION_CACHE_MAX_ENTRIES=256

# Beam search for the offline Opus-MT model (1 = old greedy decoding).
OPUSMT_NUM_BEAMS=4

# ---------------------------------------------------------------------------
# Optional multi-provider AI ensemble
#
# The app works fully offline without these keys. When one or more are set, the
# backend queries every configured provider in parallel and keeps the best
# answer (token-safe consensus). Keys never reach the browser.
#
# Copy this file to backend/.env and restart the backend after editing.
# ---------------------------------------------------------------------------

# OpenAI (ChatGPT models)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude models)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Perplexity (Sonar models)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Preference order. Providers omitted here are still used if configured.
AI_PROVIDER_ORDER=openai,anthropic,perplexity

# Feature switch and guard rails
AI_ENABLED=true
AI_MAX_REQUESTS_PER_MINUTE=20
AI_MAX_CHARS=4000
AI_CACHE_TTL_SECONDS=900
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=45
