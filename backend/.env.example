# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------
MAX_OCR_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Optional Google Cloud Translation (Basic v2)
#
# Set an API key from Google Cloud Console (APIs & Services -> Credentials) to
# enable the "google", "auto" and "hybrid" translation engines. The key is used
# server-side only. Without it the app stays fully offline and the UI hides the
# Google options.
# ---------------------------------------------------------------------------
GOOGLE_TRANSLATE_API_KEY=
# Alias supported for existing deployments:
# GOOGLE_API_KEY=
GOOGLE_TRANSLATE_BASE_URL=https://translation.googleapis.com/language/translate/v2
GOOGLE_TRANSLATE_TIMEOUT_SECONDS=20
GOOGLE_TRANSLATE_RETRIES=2
GOOGLE_TRANSLATE_MAX_CHARS=4000

# Cache successful translations (seconds / entries). Helps avoid paying twice
# for the same debounced keystroke.
TRANSLATION_CACHE_TTL_SECONDS=900
TRANSLATION_CACHE_MAX_ENTRIES=256

# Beam search for the offline Opus-MT model (1 = old greedy decoding).
OPUSMT_NUM_BEAMS=4

# ---------------------------------------------------------------------------
# Optional multi-provider AI ensemble
#
# The app works fully offline without these keys. When one or more are set, the
# backend queries every configured provider in parallel and keeps the best
# answer (token-safe consensus). Keys never reach the browser.
#
# Copy this file to backend/.env and restart the backend after editing.
# ---------------------------------------------------------------------------

# OpenAI (ChatGPT models)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude models)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Perplexity (Sonar models)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Preference order. Providers omitted here are still used if configured.
AI_PROVIDER_ORDER=openai,anthropic,perplexity

# Feature switch and guard rails
AI_ENABLED=true
AI_MAX_REQUESTS_PER_MINUTE=20
AI_MAX_CHARS=4000
AI_CACHE_TTL_SECONDS=900
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=45
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Required only to store encrypted student-owned provider keys. Back up separately from the DB.
AI_CREDENTIALS_ENCRYPTION_KEY=
AI_HISTORY_RETENTION_ENTRIES=500

# ---------------------------------------------------------------------------
# Authentication (required for sign-in)
#
# Accounts, sessions and one-time e-mail tokens are stored in SQLite, and
# Google sign-in uses the server-side OAuth authorization-code flow. Nothing
# here is optional for a working login: without it the app has no accounts.
# ---------------------------------------------------------------------------

# Where the account database lives (defaults to backend/auth.db).
AUTH_DB_PATH=auth.db

# Public origin of the frontend. Used for post-auth redirects and e-mail links.
# No trailing slash. For local Vite development use port 5173.
# This must be the exact origin you registered with Google. If the app is
# opened on another hostname (127.0.0.1 instead of localhost, or a preview
# host), Google sign-in first redirects to this canonical origin so the OAuth
# state cookie is kept on one host.
AUTH_APP_BASE_URL=http://localhost:5173

# Session lifetime in days, and set to true once the site is served over HTTPS.
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false
# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For for
# authentication throttling. Keep empty unless requests only reach the API
# through those proxies.
AUTH_TRUSTED_PROXY_IPS=

# Require a signed-in session for /translation, /text, /feedback, /ocr, /ai and
# /vocab as well (the UI always requires sign-in). Enable this in production if
# anonymous API access is not wanted.
AUTH_PROTECT_FEATURES=false

# Google OAuth 2.0 credentials:
#   Google Cloud Console -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application.
# Authorised JavaScript origin:  http://localhost:5173
# Authorised redirect URI:       http://localhost:5173/auth/google/callback
# Production: set these to your public HTTPS frontend origin/callback URL.
# The callback path must be reverse-proxied to the backend /auth/google/callback.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Optional override; defaults to <AUTH_APP_BASE_URL>/auth/google/callback.
# Register this exact URL in Google Cloud Console.
# AUTH_GOOGLE_REDIRECT_URI=

# SMTP for verification and password-reset e-mails. Without a host the tokens
# are still created but no message is sent (the API reports this honestly).
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
AUTH_SMTP_STARTTLS=true
